    "dev:h5": "cross-env NODE_ENV=development UNI_PLATFORM=h5 vue-cli-service uni-serve",
    "build:h5": "cross-env NODE_ENV=production UNI_PLATFORM=h5 vue-cli-service uni-build"
  },
  "dependencies": {
    "ali-oss": "^6.23.0"
  },
  "devDependencies": {
    "@dcloudio/uni-cli-shared": "2.0.2-alpha-5000020260106001",
    "@dcloudio/vue-cli-plugin-uni": "2.0.2-alpha-5000020260106001",
    "cross-env": "^7.0.3"
  },
  "browserslist": [
    "Android >= 4.4",
    "ios >= 9"
  ],
  "uni-app": {
    "scripts": {}
